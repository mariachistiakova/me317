# Historical, normal and Student-t VaR and ES.
risk <- function(alpha)
{
  VaR.h <- as.numeric(quantile(loss.train, alpha))
  ES.h <- mean(loss.train[loss.train >= VaR.h])
  VaR.n <- mean(loss.train) + sd(loss.train) * qnorm(alpha)
  ES.n <- mean(loss.train) + sd(loss.train) *
    dnorm(qnorm(alpha)) / (1 - alpha)
  q <- qt(alpha, t.par["df"])
  VaR.t <- t.par["m"] + t.par["s"] * q
  ES.t <- t.par["m"] + t.par["s"] * dt(q, t.par["df"]) /
    (1 - alpha) * (t.par["df"] + q^2) / (t.par["df"] - 1)
  result <- c(Historical.VaR = VaR.h,
              Historical.ES = ES.h,
              Normal.VaR = VaR.n,
              Normal.ES = ES.n,
              Student.t.VaR = VaR.t,
              Student.t.ES = ES.t)
  return(result)
}
