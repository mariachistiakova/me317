# Jarque-Bera test for each column
JBTest <- function(dataMatrix)
{
  pvals <- rep(NA, ncol(dataMatrix))
  for(i in 1:ncol(dataMatrix))
  {
    pvals[i] <- tseries::jarque.bera.test(dataMatrix[, i])$p.value
  }
  return(pvals)
}
