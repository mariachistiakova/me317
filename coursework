# Kupiec proportion-of-failure test.
kupiec <- function(realised.loss, VaR, alpha)
{
  n <- length(realised.loss)
  hits <- sum(realised.loss >= VaR)
  phat <- hits / n
  LR <- 2 * (dbinom(hits, n, phat, log = TRUE) -
             dbinom(hits, n, 1 - alpha, log = TRUE))
  result <- c(exceptions = hits,
              rate = phat,
              LR = LR,
              p.value = 1 - pchisq(LR, 1))
  return(result)
}
