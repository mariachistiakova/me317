# Simulated end-2020 risk with identical empirical margins.
n.sim <- 100000
position.T <- shares * as.numeric(tail(p.train, 1))
simulate.loss <- function(fitted.copula)
{
  U.sim <- rCopula(n.sim, fitted.copula@copula)
  R.sim <- matrix(NA, nrow = n.sim, ncol = ncol(X))
  for(i in 1:ncol(X)) {
    R.sim[, i] <- quantile(X[, i], U.sim[, i],
                           type = 1, names = FALSE)
  }
  L.sim <- -rowSums(sweep(exp(R.sim) - 1, 2, position.T, "*"))
  return(L.sim)
}
sim.risk <- function(L)
{
  VaR <- as.numeric(quantile(L, 0.99, type = 1))
  ES <- mean(L[L >= VaR])
  return(c(VaR = VaR, ES = ES))
}
set.seed(202607)
