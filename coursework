# 4. Dependence and copulas
# Form the pseudo-sample using ranks
U <- matrix(NA, nrow = nrow(X), ncol = ncol(X))
for(i in 1:ncol(X)) {
  U[, i] <- rank(X[, i]) / (nrow(X) + 1)
}
colnames(U) <- tickers
d <- ncol(U)
# Gaussian copula.
fit.g0 <- fitCopula(normalCopula(dim = d, dispstr = "un"), U,
                    method = "itau", estimate.variance = FALSE)
fit.g <- fitCopula(normalCopula(dim = d, dispstr = "un"), U,
                   method = "mpl", start = coef(fit.g0),
                   estimate.variance = FALSE)
# Student-t, Clayton and Gumbel copulas.
# For Student-t, itau.mpl estimates correlations from Kendall's tau
# and then estimates the degrees of freedom by pseudo-likelihood.
fit.t <- fitCopula(tCopula(dim = d, dispstr = "un", df.fixed = FALSE), U,
                   method = "itau.mpl", estimate.variance = FALSE)
fit.c <- fitCopula(claytonCopula(dim = d), U,
                   method = "mpl", estimate.variance = FALSE)
fit.gu <- fitCopula(gumbelCopula(dim = d), U,
                    method = "mpl", estimate.variance = FALSE)
fits <- list(Gaussian = fit.g,
             Student.t = fit.t,
             Clayton = fit.c,
             Gumbel = fit.gu)
# Compare log-likelihood, AIC and BIC.
# For Student-t these are evaluated at the hybrid itau.mpl estimate.
copula.table <- data.frame(model = names(fits),
                           logLik = rep(NA, length(fits)),
                           parameters = rep(NA, length(fits)),
                           AIC = rep(NA, length(fits)),
                           BIC = rep(NA, length(fits)))
for(i in 1:length(fits)) {
  copula.table$logLik[i] <- as.numeric(logLik(fits[[i]]))
  copula.table$parameters[i] <- attr(logLik(fits[[i]]), "df")
  copula.table$AIC[i] <- -2 * copula.table$logLik[i] +
    2 * copula.table$parameters[i]
  copula.table$BIC[i] <- -2 * copula.table$logLik[i] +
    log(nrow(U)) * copula.table$parameters[i]
}
rownames(copula.table) <- copula.table$model
print(round(copula.table[, 2:5], 1))
# Student-t copula lower and upper tail dependence are equal.
