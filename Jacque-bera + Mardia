  ]

  rownames(result) <- NULL
  jbresults[[horizon]] <- result

  cat("\n")
  cat("============================================\n")
  cat(
    toupper(horizon),
    "JARQUE-BERA TESTS\n"
  )
  cat("============================================\n")

  print(
    result,
    digits = 6
  )
}

