jbtest <- function(x) {
  x <- as.numeric(x)
  x <- x[!is.na(x)]

  n <- length(x)
  centredx <- x - mean(x)

  secondmoment <- mean(centredx^2)
  thirdmoment <- mean(centredx^3)
  fourthmoment <- mean(centredx^4)

  skewness <- thirdmoment / secondmoment^(3 / 2)
  kurtosis <- fourthmoment / secondmoment^2
  excesskurtosis <- kurtosis - 3

  skewcontribution <- n * skewness^2 / 6
  tailcontribution <- n * excesskurtosis^2 / 24

  jbstatistic <- skewcontribution + tailcontribution

  pvalue <- pchisq(
    jbstatistic,
    df = 2,
    lower.tail = FALSE
  )

  result <- data.frame(
    N = n,
    JB = jbstatistic,
    pvalue = pvalue,
    Skewness = skewness,
    Kurtosis = kurtosis,
    Excesskurtosis = excesskurtosis,
    Skewcontribution = skewcontribution,
    Tailcontribution = tailcontribution
  )

  return(result)
}

jballstocks <- function(returndata) {
  resultlist <- lapply(
    seq_len(ncol(returndata)),
    function(j) {
      result <- jbtest(returndata[, j])
      result$Stock <- colnames(returndata)[j]

      result <- result[
        ,
        c(
          "Stock",
          "N",
          "JB",
          "pvalue",
          "Skewness",
          "Kurtosis",
          "Excesskurtosis",
          "Skewcontribution",
          "Tailcontribution"
        )
      ]

      return(result)
    }
  )

  resulttable <- do.call(rbind, resultlist)
  rownames(resulttable) <- NULL

  resulttable$Decision <- ifelse(
    resulttable$pvalue < 0.05,
    "Reject normality",
    "Do not reject normality"
  )

  return(resulttable)
}

mardiatest <- function(returndata) {
  x <- as.matrix(na.omit(returndata))

  n <- nrow(x)
  p <- ncol(x)

  means <- colMeans(x)

  centredx <- sweep(
    x,
    2,
    means,
    "-"
  )

  covariancematrix <- crossprod(centredx) / n

  inversecovariance <- tryCatch(
    solve(covariancematrix),
    error = function(e) {
      qr.solve(covariancematrix)
    }
  )

  innerproducts <- centredx %*%
    inversecovariance %*%
    t(centredx)

  mardiaskewness <- sum(innerproducts^3) / n^2

  skewnessstatistic <- n * mardiaskewness / 6

  skewnessdf <- p * (p + 1) * (p + 2) / 6

  skewnesspvalue <- pchisq(
    skewnessstatistic,
    df = skewnessdf,
    lower.tail = FALSE
  )

  squareddistances <- rowSums(
    (centredx %*% inversecovariance) * centredx
  )

  mardiakurtosis <- mean(squareddistances^2)

  expectedkurtosis <- p * (p + 2)

  kurtosisz <- (
    mardiakurtosis - expectedkurtosis
  ) / sqrt(
    8 * p * (p + 2) / n
  )

  kurtosispvalue <- 2 * pnorm(
    -abs(kurtosisz)
  )

  result <- data.frame(
    N = n,
    Variables = p,
    Mardiaskewness = mardiaskewness,
    Skewnessstatistic = skewnessstatistic,
    Skewnessdf = skewnessdf,
    Skewnesspvalue = skewnesspvalue,
    Mardiakurtosis = mardiakurtosis,
    Expectedkurtosis = expectedkurtosis,
    Kurtosisz = kurtosisz,
    Kurtosispvalue = kurtosispvalue
  )

  return(result)
}

dailymardia <- mardiatest(dailyreturns)

cat("\n")
cat("============================================\n")
cat("DAILY MARDIA TEST\n")
cat("============================================\n")

print(
  dailymardia,
  digits = 6
)

if (
  dailymardia$Skewnesspvalue < 0.05 ||
  dailymardia$Kurtosispvalue < 0.05
) {
  cat(
    "\nConclusion:",
    "Reject multivariate normality of daily returns.\n"
  )
} else {
  cat(
    "\nConclusion:",
    "Do not reject multivariate normality of daily returns.\n"
  )
}

